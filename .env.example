# Convex deployment URL (from `npx convex dev` or Convex dashboard)
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"

# Convex verifies Clerk session tokens against this issuer. Required for every
# public Convex function to authenticate callers — without it, `ctx.auth` is
# always null and the API returns 401.
#   npx convex env set CONVEX_AUTH_DOMAIN https://your-app.clerk.accounts.dev
# Leave the Next.js .env copy empty; it is set on the Convex deployment.
CONVEX_AUTH_DOMAIN=""

# Clerk authentication (from Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"

# Optional: route customization for Clerk hosted pages/components
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/signin"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/signup"

# LLM Provider — "openai", "ollama", or "openrouter"
LLM_PROVIDER="openrouter"

# OpenRouter configuration (required if LLM_PROVIDER="openrouter")
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Ollama configuration (required if LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# OpenAI configuration (required if LLM_PROVIDER="openai")
OPENAI_API_KEY=""

# Transcript service (used by episode ingestion)
# Run it locally with `npm run transcript:dev`.
TRANSCRIPT_SERVICE_URL="http://127.0.0.1:8765"

# Debug logging for LLM/transcript payloads (testing only)
# WARNING: enabling these logs prints full transcript and full model payload/response
CHAT_DEBUG_FULL_CONTEXT="false"
LLM_DEBUG_FULL_PAYLOAD="false"

# Optional: OpenAI embedding key for higher-quality semantic search
# If unset, the app uses a deterministic local fallback embedding.
OPENAI_EMBEDDINGS_API_KEY=""
